---
import BaseLayout from '../layouts/BaseLayout.astro'
import { SupportPage } from '../views/SupportPage'
import { SEO, SITE_URL } from '../data/site'
import { PRODUCT_ID } from '../lib/seo'

const jsonLdExtra = [
  {
    '@type': 'ContactPage',
    '@id': `${SITE_URL}/support#contactpage`,
    url: `${SITE_URL}/support`,
    name: SEO.support.title,
    description: SEO.support.description,
    about: { '@id': PRODUCT_ID },
    inLanguage: 'en',
    isPartOf: { '@id': `${SITE_URL}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Support', item: `${SITE_URL}/support` },
    ],
  },
]
---

<BaseLayout seo={SEO.support} jsonLdExtra={jsonLdExtra}>
  <SupportPage client:visible />
</BaseLayout>


